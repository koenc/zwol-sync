# ==============================================================================
# ZWOL Sync - Silvasoft & HubSpot Synchronisatie (.env)
# ==============================================================================

# --- Flask Server ---
FLASK_ENV=production
SECRET_KEY=zwol-sync-super-secret-key-change-in-production
PORT=8505

# --- MariaDB 10 (Synology NAS) ---
# Database naam is 'zwol'. MariaDB 10 op Synology luistert standaard op 3307.
# Als DB_HOST leeggelaten wordt, schakelt de app automatisch over op lokaal SQLite.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=zwol
DB_USER=ketelhuis
DB_PASSWORD=jouw_db_wachtwoord_hier
DB_TABLE_PREFIX=sync_

# --- SilvaSoft API ---
SILVASOFT_USERNAME=jouw_silvasoft_gebruikersnaam_hier
SILVASOFT_API_KEY=jouw_silvasoft_api_key_hier
SILVASOFT_BASE_URL=https://rest-api.silvasoft.nl/rest

# --- HubSpot API ---
# Private App Access Token (scopes nodig: crm.objects.companies.read/write, crm.objects.contacts.read/write)
HUBSPOT_ACCESS_TOKEN=jouw_hubspot_access_token_hier

# --- Queue & Rate Limiting ---
# Interval in seconden tussen Silvasoft updates (240s = 4 min = max 15 requests per uur)
SILVASOFT_QUEUE_INTERVAL_SECONDS=240
